# Copy to .env and adjust per environment. Never commit .env.
PORT=8088

POSTGRES_DB=oplearn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Base64-encoded HS256 key, >= 256 bit. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
# 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=*

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# S3 / RustFS Storage
AWS_S3_ENDPOINT=https://rustfs.tuvidausotoanthu.vn
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET_NAME=poems-media

