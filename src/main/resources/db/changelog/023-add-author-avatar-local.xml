  <!-- Ảnh chân dung tự crawl về, lưu trên object storage RustFS (bucket daithihao).
       avatar_local = key kiểu "<uuid>.<ext>"; link ảnh = <RUSTFS_PUBLIC_URL>/daithihao/<avatar_local>.
       avatar_url (URL gốc thivien) giữ nguyên, không đụng tới. -->
  <changeSet id="023-authors-avatar-local" author="claude">
    <sql>ALTER TABLE authors ADD COLUMN IF NOT EXISTS avatar_local VARCHAR(80)</sql>
  </changeSet>

