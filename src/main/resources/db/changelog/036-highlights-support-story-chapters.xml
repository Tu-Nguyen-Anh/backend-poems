<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Cho phép highlight/ghi chú trên CHƯƠNG TRUYỆN (story_chapters) dùng chung
       bảng poem_highlights: thêm story_chapter_id (nullable), poem_id trở thành
       nullable. Mỗi highlight thuộc về đúng 1 trong hai (bài thơ HOẶC chương truyện). -->
  <changeSet id="036-highlights-support-story-chapters" author="claude">
    <addColumn tableName="poem_highlights">
      <column name="story_chapter_id" type="BIGINT"/>
    </addColumn>

    <dropNotNullConstraint tableName="poem_highlights" columnName="poem_id" columnDataType="BIGINT"/>

    <createIndex indexName="idx_highlights_story_chapter" tableName="poem_highlights">
      <column name="story_chapter_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
