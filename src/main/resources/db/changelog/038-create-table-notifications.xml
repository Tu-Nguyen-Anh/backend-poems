<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- 1. Bảng lưu trữ nội dung thông báo -->
  <changeSet id="038-create-table-notifications" author="hazi">
    <createTable tableName="notifications">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <!-- recipient_id: NULL nếu là broadcast toàn hệ thống (bài thơ mới...), NOT NULL nếu là gửi đích danh cho 1 user -->
      <column name="recipient_id" type="BIGINT">
        <constraints nullable="true"
                     foreignKeyName="fk_notifications_recipient"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <!-- sender_id: Người tạo ra hành động (user reply, like...), NULL nếu từ hệ thống -->
      <column name="sender_id" type="BIGINT">
        <constraints nullable="true"
                     foreignKeyName="fk_notifications_sender"
                     references="users(id)"/>
      </column>

      <!-- type: POEM_CREATED, COMMENT_REPLY, POEM_UPDATED, SYSTEM... -->
      <column name="type" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="title" type="VARCHAR(255)"/>

      <column name="content" type="TEXT"/>

      <!-- Polymorphic reference: POEM, COMMENT, REPLY... -->
      <column name="reference_type" type="VARCHAR(50)"/>

      <column name="reference_id" type="BIGINT"/>

      <!-- BaseAuditEntity fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="created_at"
              type="TIMESTAMP WITH TIME ZONE"
              defaultValueComputed="CURRENT_TIMESTAMP"/>

      <column name="updated_at"
              type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Index tối ưu cho việc truy vấn feed thông báo của user (cá nhân + broadcast) -->
    <sql>
      CREATE INDEX IF NOT EXISTS idx_notifications_recipient_created 
      ON notifications (recipient_id, created_at DESC) 
      WHERE is_deleted = false;
    </sql>
  </changeSet>

  <!-- 2. Bảng ghi nhận trạng thái đã đọc thông báo (Có cột ID tự tăng) -->
  <changeSet id="038-create-table-notification-reads" author="hazi">
    <createTable tableName="notification_reads">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="notification_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_notification_reads_notification"
                     references="notifications(id)"
                     deleteCascade="true"/>
      </column>

      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_notification_reads_user"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>

      <column name="read_at"
              type="TIMESTAMP WITH TIME ZONE"
              defaultValueComputed="CURRENT_TIMESTAMP"/>

      <!-- BaseAuditEntity fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <!-- Ràng buộc chống trùng: Mỗi user chỉ ghi nhận đọc 1 thông báo đúng 1 lần -->
    <addUniqueConstraint tableName="notification_reads"
                         columnNames="notification_id, user_id"
                         constraintName="uq_notification_reads_notification_user"/>

    <!-- Index phục vụ query: User X đã đọc những thông báo nào / kiểm tra unread -->
    <createIndex tableName="notification_reads" indexName="idx_notification_reads_user">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
