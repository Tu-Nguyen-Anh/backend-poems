<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Dịch nghĩa (văn xuôi) cho bài thơ Hán -->
  <changeSet id="013-add-meaning-to-poems" author="claude">
    <addColumn tableName="poems">
      <column name="meaning" type="TEXT"/>
    </addColumn>
  </changeSet>

  <!-- Nhiều bản dịch thơ (mỗi bản một dịch giả) -->
  <changeSet id="013-create-poem-translations" author="claude">
    <createTable tableName="poem_translations">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="poem_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_poem_translations_poem"
                     references="poems(id)"/>
      </column>
      <column name="translator" type="VARCHAR(255)"/>
      <column name="content" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="sort_order" type="INTEGER" defaultValueNumeric="0"/>
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <createIndex tableName="poem_translations" indexName="idx_poem_translations_poem">
      <column name="poem_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
