<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="033-create-auth-provider-enum" author="hazi">
    <sql>
      CREATE TYPE auth_provider_enum AS ENUM ('LOCAL', 'GOOGLE');
    </sql>
  </changeSet>

  <changeSet id="033-modify-users-for-oauth" author="hazi">
    <dropNotNullConstraint tableName="users" columnName="password" columnDataType="VARCHAR(255)"/>
    <dropNotNullConstraint tableName="users" columnName="phone_number" columnDataType="VARCHAR(50)"/>

    <addColumn tableName="users">
      <column name="provider" type="auth_provider_enum" defaultValue="LOCAL"/>
      <column name="provider_id" type="VARCHAR(255)"/>
    </addColumn>

    <createIndex tableName="users" indexName="idx_users_provider_provider_id">
      <column name="provider"/>
      <column name="provider_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
